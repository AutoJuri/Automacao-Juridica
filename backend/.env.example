# Copie para .env e preencha. Nunca commite o arquivo .env.

# Em qualquer deploy real (Railway, staging, produção) defina APP_ENV=production.
# Deixar "development" fora do seu ambiente local desliga proteções críticas:
# o cookie de refresh perde o atributo Secure, e JWT_SECRET/AES_KEY com o valor
# de exemplo abaixo passam a ser aceitos em vez de travar o boot.
APP_ENV=development

# PostgreSQL — cole aqui a connection string do Railway como ela vem
# (aba do Postgres > Variables > DATABASE_PUBLIC_URL). O prefixo postgresql://
# é convertido para postgresql+asyncpg:// automaticamente em app/core/config.py.
DATABASE_URL=postgresql://postgres:senha@monorail.proxy.rlwy.net:20000/railway

# JWT — fora de development o segredo precisa ter no mínimo 32 caracteres
# (gere com: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me-jwt-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Validade do link de redefinição de senha
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# AES-256 (credenciais e cookies do e-SAJ) — qualquer string longa e aleatória
# serve, é normalizada para 32 bytes via SHA-256 (gere com o mesmo comando do JWT_SECRET)
AES_KEY=change-me-32-byte-aes-key!!!!!!

# CORS — origens permitidas separadas por vírgula
CORS_ORIGINS=http://localhost:3000

# OAuth2 Gmail — Google Cloud Console > APIs e Serviços > Credenciais
# Criar um OAuth Client ID do tipo "Web application" (NÃO "Desktop app").
# Escopo: https://www.googleapis.com/auth/gmail.readonly (somente leitura)
# Redirect URI autorizado precisa ser IDÊNTICO ao valor abaixo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/credentials/email/gmail/callback

# OAuth2 Outlook — Azure Portal > Entra ID > App registrations
# Permissão delegada do Microsoft Graph: Mail.Read + offline_access
# Redirect URI (plataforma "Web") precisa ser IDÊNTICO ao valor abaixo.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:8000/credentials/email/outlook/callback
