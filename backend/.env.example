# Copie para .env e preencha. Nunca commite o arquivo .env.

APP_ENV=development

# PostgreSQL — cole aqui a connection string do Railway como ela vem
# (aba do Postgres > Variables > DATABASE_PUBLIC_URL). O prefixo postgresql://
# é convertido para postgresql+asyncpg:// automaticamente em app/core/config.py.
DATABASE_URL=postgresql://postgres:senha@monorail.proxy.rlwy.net:20000/railway

# JWT
JWT_SECRET=change-me-jwt-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AES-256 (credenciais e cookies do e-SAJ) — use 32 bytes
AES_KEY=change-me-32-byte-aes-key!!!!!!

# CORS — origens permitidas separadas por vírgula
CORS_ORIGINS=http://localhost:3000
