# Nomes das variáveis do serviço da API no Railway (Variables).
# NÃO copie este arquivo para .env e NÃO cole placeholders de development.
# Gere JWT_SECRET e AES_KEY (dois valores diferentes, ≥ 32 caracteres):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Checklist completo: docs/modulos/deploy.md

APP_ENV=production

# Reference da DATABASE_URL do plugin Postgres (rede interna do Railway).
# Não use DATABASE_PUBLIC_URL neste serviço.
DATABASE_URL=

JWT_SECRET=
AES_KEY=

# URL HTTPS do frontend, sem barra no final.
# Cookie SameSite=Strict: front e API no mesmo site
# (ex.: https://app.dominio.com se a API for https://api.dominio.com).
# Dois *.up.railway.app diferentes quebram o refresh no F5.
CORS_ORIGINS=

# Opcional. Em APP_ENV=production os jobs já ligam sozinhos.
# SCHEDULER_ENABLED=false

# Opcional até o redirect ser a URL pública desta API
# (https://<api>/credentials/email/gmail/callback — idêntico no Google Cloud).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=

# Opcional. Vazio = job DataJud não consulta o CNJ.
DATAJUD_API_KEY=
